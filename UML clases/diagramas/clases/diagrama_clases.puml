@startuml
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle

skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #2B2D42
    ArrowColor #2B2D42
    HeaderBackgroundColor #E9ECEF
}

skinparam package {
    BackgroundColor #F1F3F5
    BorderColor #ADB5BD
    FontStyle bold
}

' ==============================================================================
' CAPA DE PRESENTACIÓN (HTTP / REST Web)
' ==============================================================================
package "Capa de Presentacion" as Presentacion <<Layer>> {
    class "VisualizacionController" as VisualizacionController <<REST Controller>> {
        + obtenerDatosGrafica(idDisp, minuto) : DatosGraficaMinuto
    }

    class "IncidenciasController" as IncidenciasController <<REST Controller>> {
        + publicarIncidencia(dto) : IncidenciaDTO
        + listarIncidencias(idDisp) : List<IncidenciaDTO>
        + suscribirGestor(idGestor, tipo) : SuscripcionDTO
        + cancelarSuscripcion(idSub) : void
        + listarSuscripcionesGestor(idGestor) : List<SuscripcionDTO>
    }
}

' ==============================================================================
' CAPA DE APLICACIÓN (Casos de Uso, DTOs y Puertos/Interfaces)
' ==============================================================================
package "Capa de Aplicacion" as Aplicacion <<Layer>> {
    ' Modelos de Transferencia de Datos
    class "PublicarIncidenciaDTO" as PublicarIncidenciaDTO <<DTO>>
    class "IncidenciaDTO" as IncidenciaDTO <<DTO>>
    class "SuscripcionDTO" as SuscripcionDTO <<DTO>>
    class "IncidenciaGraficaDTO" as IncidenciaGraficaDTO <<DTO>>
    class "DatosGraficaMinuto" as DatosGraficaMinuto <<DTO>>

    ' Puertos / Contratos de Aplicación
    interface "IModuloMachineLearning" as IModuloMachineLearning <<Port>> {
        + detectarIncidencias(mediciones) : List<Incidencia>
        + predecirIncidencias(historico) : List<PrediccionIncidencia>
    }

    interface "ILectorCSV" as ILectorCSV <<Port>> {
        + leerMediciones(rutaFichero) : List<MedicionElectrica>
    }

    ' Servicios de Aplicación (Casos de Uso)
    class "ServicioAdquisicionDatos" as ServicioAdquisicionDatos <<Service>> {
        + procesarFicheroCSV(ruta, idDisp) : int
    }

    class "ServicioIncidencias" as ServicioIncidencias <<Service>> {
        + evaluarIncidenciasDispositivo(idDisp) : List<IncidenciaDTO>
        + registrarIncidenciaManual(dto) : IncidenciaDTO
        + obtenerIncidenciasDispositivo(idDisp) : List<IncidenciaDTO>
    }

    class "ServicioPrediccion" as ServicioPrediccion <<Service>> {
        + generarPredicciones(idDisp) : List<PrediccionIncidencia>
    }

    class "ServicioSuscripciones" as ServicioSuscripciones <<Service>> {
        + suscribirGestor(idGestor, tipoIncidencia) : SuscripcionDTO
        + cancelarSuscripcion(idSub) : void
        + obtenerSuscripcionesGestor(idGestor) : List<SuscripcionDTO>
    }

    class "ServicioVisualizacion" as ServicioVisualizacion <<Service>> {
        + prepararDatosMinuto(idDisp, minuto) : DatosGraficaMinuto
    }
}

' ==============================================================================
' CAPA DE DOMINIO (Entidades, Objetos de Valor y Enumeraciones)
' ==============================================================================
package "Capa de Dominio" as Dominio <<Layer>> {
    class "ViaFerroviaria" as ViaFerroviaria <<Entity>> {
        - idVia : String
        - nombre : String
    }

    class "DispositivoVia" as DispositivoVia <<Entity>> {
        - idDispositivo : String
        - separacionSiguienteMetros : int
        - puntoKilometrico : double
    }

    class "MedicionElectrica" as MedicionElectrica <<Value Object>> {
        - hora : String
        - voltaje : double
        - estado : EstadoOcupacion
    }

    class "Incidencia" as Incidencia <<Entity>> {
        - idIncidencia : String
        - fechaHora : DateTime
        - tipo : TipoIncidencia
        - origen : OrigenIncidencia
        - descripcion : String
    }

    class "PrediccionIncidencia" as PrediccionIncidencia <<Entity>> {
        - idPrediccion : String
        - fechaHoraCalculo : DateTime
        - tipoPronosticado : TipoIncidencia
        - probabilidad : double
        - horizonteEstimadoMinutos : int
    }

    class "Usuario" as Usuario <<Entity>> {
        - idUsuario : String
        - nombre : String
        - email : String
    }

    class "Gestor" as Gestor <<Entity>>

    class "Suscripcion" as Suscripcion <<Entity>> {
        - idSuscripcion : String
        - fechaAlta : DateTime
        - tipoIncidencia : TipoIncidencia
    }

    enum "EstadoOcupacion" as EstadoOcupacion <<Enumeration>> {
        OCUPADO : 0
        LIBRE : 1
    }

    enum "TipoIncidencia" as TipoIncidencia <<Enumeration>> {
        BLOQUEO_PROLONGADO
        SALTO_FRECUENCIA
    }

    enum "OrigenIncidencia" as OrigenIncidencia <<Enumeration>> {
        DETECTADA_ML
        PUBLICADA_USUARIO
    }
}

' ==============================================================================
' CAPA DE INFRAESTRUCTURA (Adaptadores Técnicos)
' ==============================================================================
package "Capa de Infraestructura" as Infraestructura <<Layer>> {
    class "LectorCSV" as LectorCSV <<Adapter>>
    class "ModuloMachineLearning" as ModuloMachineLearning <<Adapter>>
}

' ==============================================================================
' RELACIONES ENTRE CAPAS (Presentación -> Aplicación)
' ==============================================================================
VisualizacionController --> ServicioVisualizacion : delega en >
VisualizacionController ..> DatosGraficaMinuto : usa >
IncidenciasController --> ServicioIncidencias : delega en >
IncidenciasController --> ServicioSuscripciones : delega en >
IncidenciasController ..> PublicarIncidenciaDTO : recibe >
IncidenciasController ..> IncidenciaDTO : retorna >
IncidenciasController ..> SuscripcionDTO : retorna >

' ==============================================================================
' RELACIONES EN APLICACIÓN (Internas y hacia Dominio)
' ==============================================================================
DatosGraficaMinuto *-- "0..*" IncidenciaGraficaDTO : compone >

ServicioAdquisicionDatos --> ILectorCSV : usa >
ServicioAdquisicionDatos ..> DispositivoVia : actualiza >

ServicioIncidencias --> IModuloMachineLearning : usa >
ServicioIncidencias ..> DispositivoVia : consulta >
ServicioIncidencias ..> Incidencia : crea >
ServicioIncidencias ..> IncidenciaDTO : genera >

ServicioPrediccion --> IModuloMachineLearning : usa >
ServicioPrediccion ..> DispositivoVia : consulta >
ServicioPrediccion ..> PrediccionIncidencia : genera >

ServicioSuscripciones ..> Gestor : consulta >
ServicioSuscripciones ..> Suscripcion : gestiona >
ServicioSuscripciones ..> SuscripcionDTO : genera >

' Colaboración de ServicioVisualizacion con servicios y DTOs
ServicioVisualizacion ..> ServicioIncidencias : consulta incidencias >
ServicioVisualizacion ..> ServicioPrediccion : consulta predicciones >
ServicioVisualizacion ..> DispositivoVia : consulta mediciones >
ServicioVisualizacion ..> IncidenciaGraficaDTO : transforma a >
ServicioVisualizacion ..> DatosGraficaMinuto : genera >

' ==============================================================================
' RELACIONES EN DOMINIO
' ==============================================================================
ViaFerroviaria "1" *-- "0..*" DispositivoVia : contiene >
DispositivoVia "1" *-- "0..*" MedicionElectrica : registra >
DispositivoVia "1" o-- "0..*" Incidencia : afectada por >
DispositivoVia "1" o-- "0..*" PrediccionIncidencia : objeto de >
Usuario <|-- Gestor : herencia
Gestor "1" *-- "0..*" Suscripcion : gestiona >

' ==============================================================================
' RELACIONES DE INFRAESTRUCTURA (Inversión de Dependencias DIP)
' ==============================================================================
LectorCSV ..|> ILectorCSV : realiza
ModuloMachineLearning ..|> IModuloMachineLearning : realiza
LectorCSV ..> MedicionElectrica : crea

' ==============================================================================
' NOTA DE VISTA GLOBAL
' ==============================================================================
note top of Presentacion
  <b>Diagrama Global Simplificado (Cierre Definitivo)</b>
  - Arquitectura en 4 capas estrictas (monolito modular).
  - Consulta detalles en las vistas complementarias:
    * Dominio: detalle_clases_dominio.puml
    * Aplicacion: detalle_clases_aplicacion.puml
    * Externas: detalle_clases_externas.puml
end note

@enduml
