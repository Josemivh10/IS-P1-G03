@startuml
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle

skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #2B2D42
    ArrowColor #2B2D42
    HeaderBackgroundColor #E9ECEF
}

skinparam package {
    BackgroundColor #F1F3F5
    BorderColor #ADB5BD
    FontStyle bold
}

' ==============================================================================
' VISTA COMPLEMENTARIA: DETALLE DE PRESENTACIÓN E INFRAESTRUCTURA
' Fronteras Externas del Sistema (HTTP/REST Web y Adaptadores Técnicos CSV/ML)
' Cobertura: RD1, RF1.1, RF1.5, RF2, RF4.1, RF4.2, RF5.1, RF5.2, RF5.3
' ==============================================================================

package "Capa de Presentacion (HTTP/REST Web)" as Presentacion <<Layer>> {
    class "VisualizacionController" as VisualizacionController <<REST Controller>> {
        - servicioVisualizacion : ServicioVisualizacion
        + obtenerDatosGrafica(idDispositivo : String, minuto : String) : DatosGraficaMinuto
    }

    class "IncidenciasController" as IncidenciasController <<REST Controller>> {
        - servicioIncidencias : ServicioIncidencias
        - servicioSuscripciones : ServicioSuscripciones
        + publicarIncidencia(dto : PublicarIncidenciaDTO) : IncidenciaDTO
        + listarIncidencias(idDispositivo : String) : List<IncidenciaDTO>
        + suscribirGestor(idGestor : String, tipo : String) : SuscripcionDTO
        + cancelarSuscripcion(idSuscripcion : String) : void
        + listarSuscripcionesGestor(idGestor : String) : List<SuscripcionDTO>
    }
}

package "Capa de Infraestructura (Adaptadores Tecnicos)" as Infraestructura <<Layer>> {
    class "LectorCSV" as LectorCSV <<Adapter>> {
        + leerMediciones(rutaFichero : String) : List<MedicionElectrica>
        - parsearHora(token : String) : String
        - parsearVoltaje(token : String) : double
        - parsearEstado(token : String) : EstadoOcupacion
    }

    class "ModuloMachineLearning" as ModuloMachineLearning <<Adapter>> {
        + detectarIncidencias(mediciones : List<MedicionElectrica>) : List<Incidencia>
        + predecirIncidencias(historico : List<MedicionElectrica>) : List<PrediccionIncidencia>
        - analizarBloqueoProlongado(mediciones : List<MedicionElectrica>) : List<Incidencia>
        - analizarSaltoFrecuencia(mediciones : List<MedicionElectrica>) : List<Incidencia>
    }
}

package "Aplicacion (Contratos y Modelos de Entrada/Salida)" as AplicacionContratos <<External>> {
    class "PublicarIncidenciaDTO" as PublicarIncidenciaDTO <<DTO>>
    class "IncidenciaDTO" as IncidenciaDTO <<DTO>>
    class "SuscripcionDTO" as SuscripcionDTO <<DTO>>
    class "DatosGraficaMinuto" as DatosGraficaMinuto <<DTO>>

    interface "ILectorCSV" as ILectorCSV <<Port>> {
        + leerMediciones(rutaFichero : String) : List<MedicionElectrica>
    }

    interface "IModuloMachineLearning" as IModuloMachineLearning <<Port>> {
        + detectarIncidencias(mediciones : List<MedicionElectrica>) : List<Incidencia>
        + predecirIncidencias(historico : List<MedicionElectrica>) : List<PrediccionIncidencia>
    }

    class "ServicioVisualizacion" as ServicioVisualizacion <<Service>>
    class "ServicioIncidencias" as ServicioIncidencias <<Service>>
    class "ServicioSuscripciones" as ServicioSuscripciones <<Service>>
}

' ==============================================================================
' RELACIONES DE PRESENTACIÓN
' ==============================================================================
VisualizacionController --> ServicioVisualizacion : delega >
VisualizacionController ..> DatosGraficaMinuto : retorna >
IncidenciasController --> ServicioIncidencias : delega >
IncidenciasController --> ServicioSuscripciones : delega >
IncidenciasController ..> PublicarIncidenciaDTO : recibe >
IncidenciasController ..> IncidenciaDTO : retorna >
IncidenciasController ..> SuscripcionDTO : retorna >

' ==============================================================================
' RELACIONES DE INFRAESTRUCTURA (INVERSIÓN DE DEPENDENCIAS DIP)
' ==============================================================================
LectorCSV ..|> ILectorCSV : realiza contrato
ModuloMachineLearning ..|> IModuloMachineLearning : realiza contrato

note top of Presentacion
  <b>Capa Web REST (RD1, RF1.5)</b>
  - Aislamiento absoluto: interactua exclusivamente
    con los Servicios y DTOs de Aplicacion.
  - Ninguna entidad de Dominio es expuesta.
end note

note bottom of Infraestructura
  <b>Adaptadores Tecnicos Externos</b>
  - Ingestion de ficheros tabulares CSV (RF2).
  - Algoritmos ML para deteccion y prediccion dual (RF1.1-RF1.4).
  - Desacoplados mediante puertos de Aplicacion (DIP).
end note

@enduml
